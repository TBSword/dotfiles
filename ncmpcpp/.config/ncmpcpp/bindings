def_key "j"
  scroll_down

def_key "k"
  scroll_up

def_key "ctrl-d"
  page_down

def_key "ctrl-u"
  page_up

def_key "shift-j"
  move_selected_items_down

def_key "shift-k"
  move_selected_items_up

def_key "h"
  previous_column

def_key "l"
  next_column

def_key "q"
  quit

def_key "ctrl-down"
  volume_down

def_key "ctrl-up"
  volume_up

def_key "f"
  seek_forward

def_key "b"
  seek_backward
