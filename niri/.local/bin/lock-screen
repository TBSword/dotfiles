#!/bin/sh
set -eu

state_file="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper/current"
wallpaper_dir="${WALLPAPER_DIR:-$HOME/Pictures/wallpapers}"
default="$wallpaper_dir/default.jpg"
if [ ! -f "$default" ]; then
    default=$(find -L "$wallpaper_dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -printf '%p\n' 2>/dev/null | sort | head -n 1 || true)
fi
[ -n "$default" ] && [ -f "$default" ] || default="$HOME/Pictures/潮式鮑魚迷你裹蒸粽2.jpg"

image=""
if [ -r "$state_file" ]; then
    image=$(cat "$state_file" 2>/dev/null || true)
fi
if [ -z "$image" ] || [ ! -f "$image" ]; then
    image=$default
fi

if [ -f "$image" ]; then
    exec /usr/bin/swaylock -f -i "$image"
fi
exec /usr/bin/swaylock -f
