#!/bin/sh
set -eu

state_file="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper/current"
wallpaper_dir="${WALLPAPER_DIR:-$HOME/Pictures/wallpapers}"
default="$wallpaper_dir/default.jpg"
if [ ! -f "$default" ]; then
    default=$(find -L "$wallpaper_dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -printf '%p\n' 2>/dev/null | sort | head -n 1 || true)
fi
[ -n "$default" ] && [ -f "$default" ] || default="$HOME/Pictures/潮式鮑魚迷你裹蒸粽2.jpg"

image=""
if [ "$#" -gt 0 ]; then
    image=$1
fi
if [ -z "$image" ] && [ -r "$state_file" ]; then
    image=$(cat "$state_file" 2>/dev/null || true)
fi
if [ -z "$image" ] || [ ! -f "$image" ]; then
    image=$default
fi

if [ ! -f "$image" ]; then
    exec /usr/bin/swaybg -c '#1c2320'
fi

image=$(readlink -f "$image")
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper"
mkdir -p "$state_dir"
printf '%s\n' "$image" > "$state_file"

matugen_config="$HOME/.config/matugen/config.toml"
[ -f "$matugen_config" ] || matugen_config="$HOME/dotfiles/matugen/.config/matugen/config.toml"
if command -v matugen >/dev/null 2>&1 && [ -f "$matugen_config" ]; then
    matugen -q -m dark -c "$matugen_config" image "$image" >/dev/null 2>&1 || true
fi

pkill -x swaybg 2>/dev/null || true
i=0
while pgrep -x swaybg >/dev/null 2>&1; do
    i=$((i + 1))
    if [ "$i" -ge 20 ]; then
        pkill -9 -x swaybg 2>/dev/null || true
        break
    fi
    sleep 0.05
done

exec /usr/bin/swaybg -m fill -i "$image"
