// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,
    "margin-top": 4,
    "margin-left": 8,
    "margin-right": 8,

    "modules-left": [
        "niri/workspaces",
        "mpris"
    ],
    "modules-center": [
        "niri/window"
    ],
    "modules-right": [
        "idle_inhibitor",
        "wireplumber",
        "network",
        "cpu",
        "memory",
        "temperature",
        "backlight",
        "battery",
        "clock",
        "tray",
        "custom/power"
    ],

    // ── niri modules ──────────────────────────────────────────

    "niri/workspaces": {
        "format": "{icon} {name}",
        "format-icons": {
            "urgent": " ",
            "focused": " ",
            "active": " ",
            "default": " "
        },
        "disable-click": false,
        "all-outputs": false,
        "current-only": false,
        "on-click": "activate"
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 80,
        "separate-outputs": true,
        "rewrite": {
            "(.*) - Mozilla Firefox": "  $1",
            "(.*) - Chromium": "  $1",
            "(.*) - Google Chrome": "  $1",
            "(.*) - Nautilus": "  $1",
            "(.*) - Alacritty": "  $1",
            "(.*) - kitty": "  $1",
            "(.*) - foot": "  $1"
        }
    },

    // ── system modules ────────────────────────────────────────

    "cpu": {
        "format": "  {usage}%",
        "tooltip": false,
        "interval": 5
    },

    "memory": {
        "format": "  {}%",
        "tooltip": false,
        "interval": 10
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", "", "", ""],
        "interval": 5
    },

    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "{icon} {capacity}%",
        "format-plugged": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip": true
    },

    "network": {
        "format-wifi": "   {signalStrength}%",
        "format-ethernet": "󰈀  {ipaddr}",
        "format-linked": "󰈀  {ifname}",
        "format-disconnected": "󰤮  Disconnected",
        "format-alt": "   {essid}",
        "tooltip-format": "{ifname}\n {ipaddr}/{cidr}\n {frequency} MHz",
        "on-click": "nm-connection-editor"
    },

    "wireplumber": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  Muted",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", "󰕾", ""]
        },
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
    },

    // ── idle inhibitor ─────────────────────────────────────────

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰛔",
            "deactivated": "󰛕"
        },
        "tooltip": true,
        "tooltip-format-activated": "Idle inhibitor on",
        "tooltip-format-deactivated": "Idle inhibitor off"
    },

    // ── mpris (auto-hides when nothing playing) ────────────────

    "mpris": {
        "format": "{player_icon}  {dynamic}",
        "format-playing": "{player_icon}  {artist} - {title}",
        "format-paused": "{player_icon}  {status}",
        "max-length": 45,
        "player-icons": {
            "spotify": "󰓇",
            "firefox": "󰈹",
            "chromium": "󰊯",
            "vlc": "󰕼",
            "mpv": "󰝚",
            "default": "󰝚"
        },
        "status-icons": {
            "Playing": "󰐊",
            "Paused": "󰏤",
            "Stopped": "󰓛"
        },
        "dynamic-importance-order": ["title", "artist", "album", "position", "length", "player"],
        "tooltip-format": "{player}\n{artist} - {album}\n{title}\n{length}",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "interval": 3
    },

    // ── clock / tray / power ──────────────────────────────────

    "clock": {
        "format": "󰥔  {:%H:%M}",
        "format-alt": "󰃭  {:%Y-%m-%d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "interval": 30
    },

    "tray": {
        "spacing": 8
    },

    "custom/power": {
        "format": "{}",
        "exec": "echo -n '⏻ '",
        "interval": "once",
        "tooltip": false,
        "on-click": "$HOME/.config/waybar/power.sh",
        "on-click-right": "niri msg action quit"
    }
}
